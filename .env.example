# ===== Сервер-прокси для Telegram =====
# Скопируй этот файл в .env и заполни значениями.
# BOT_TOKEN: токен бота от @BotFather (никому не показывай!).
BOT_TOKEN="ВАШ_ТОКЕН_БОТА"

# CHAT_IDS: ID админов через запятую, кому приходят заявки с сайта.
CHAT_IDS="123456789,987654321"

# PORT: порт локального сервера.
PORT=3001

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
